# Default: genuine local inference, no paid API or key required.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT=180
LLM_MAX_ATTEMPTS=2
LLM_TEMPERATURE=0
# Optional only if switching LLM_PROVIDER=openai explicitly:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
